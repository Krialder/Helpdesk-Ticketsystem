<?xml version="1.0" encoding="utf-8"?>
<!--
  Legt die Paketquelle für dieses Projekt verbindlich fest. Ohne diese Datei
  gilt die NuGet-Konfiguration des jeweiligen PCs, und auf Rechnern, deren
  Konfiguration nuget.org nicht enthält (typisch nach einer Visual-Studio-
  Installation: nur "Microsoft Visual Studio Offline Packages"), scheitert
  die Wiederherstellung mit NU1101 "Paket nicht gefunden". <clear /> blendet
  die Maschinen-Quellen aus, damit der Build überall gleich läuft.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
